rules_version = '2';

// Cách áp dụng:
// 1. Vào Firebase Console -> Firestore Database -> Rules, dán toàn bộ nội dung này, bấm Publish.
// 2. Hoặc firebase CLI: lưu file này ở gốc dự án, chạy `firebase deploy --only firestore:rules`.
//
// Khớp đúng cấu trúc dữ liệu trong comicCloudStore.ts:
//   comicProjects/{projectId}         → ownerUid, ownerEmail, ownerName, collaboratorEmails[]
//   users/{uid}/characterBank/{id}    → kho nhân vật CÁ NHÂN, không chia sẻ
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    function isCollaborator(data) {
      return isSignedIn() && request.auth.token.email != null
        && data.collaboratorEmails.hasAny([request.auth.token.email.lower()]);
    }

    match /comicProjects/{projectId} {
      // Đọc/sửa: chủ sở hữu HOẶC đồng nghiệp được mời (collaboratorEmails).
      allow read, update: if isOwner(resource.data) || isCollaborator(resource.data);
      // Tạo mới: chỉ khi người tạo tự gán mình làm ownerUid (khớp createCloudProject).
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Xoá: CHỈ chủ sở hữu (collaborator không được xoá dự án).
      allow delete: if isOwner(resource.data);
    }

    match /users/{uid}/characterBank/{characterId} {
      // Kho nhân vật cá nhân — chỉ chính chủ mới đọc/ghi được.
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Mặc định: chặn tất cả collection khác chưa khai báo rule riêng.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}