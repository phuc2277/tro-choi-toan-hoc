rules_version = '2';

// Cách áp dụng:
// 1. Vào Firebase Console -> Storage -> Rules, dán toàn bộ nội dung này, bấm Publish.
//    Lần đầu dùng firestore.get(), Console sẽ hỏi bật quyền liên kết Storage <-> Firestore — đồng ý.
// 2. Hoặc firebase CLI: lưu file này ở gốc dự án, chạy `firebase deploy --only storage`.
//
// Storage tự nó không biết ai là "chủ" 1 dự án — nên rule này tra cứu ngược sang
// document Firestore tương ứng (comicProjects/{projectId}) để kiểm tra ownerUid/
// collaboratorEmails, y hệt logic trong comicCloudStore.ts.
//
// Cấu trúc đường dẫn Storage tương ứng (xem comicStorage.ts):
//   comic-projects/{projectId}/frames/{frameId}/image.*
//   comic-projects/{projectId}/frames/{frameId}/video.*
//   comic-projects/{projectId}/characters/{characterId}/reference.*
service firebase.storage {
  match /b/{bucket}/o {

    match /comic-projects/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/comicProjects/$(projectId)).data.ownerUid == request.auth.uid
        ||
        (
          request.auth.token.email != null &&
          firestore.get(/databases/(default)/documents/comicProjects/$(projectId)).data.collaboratorEmails
            .hasAny([request.auth.token.email.lower()])
        )
      );
    }

    // Mặc định: chặn tất cả những gì không khớp rule ở trên.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}